    <string name="value_replace">Replace</string>
    <string name="value_problem_before_latest">A new value cannot be dated before the latest one.</string>

    <!-- S-13 and S-14 Update -->
    <string name="update_title">Update your accounts</string>
    <string name="update_body">Bring every account up to date in one go, the one updated longest ago first. Each value is saved as you enter it, so you can stop part-way and carry on later.</string>
