<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">Fortuna</string>

    <!-- S-01 Welcome -->
    <string name="welcome_title">Welcome to Fortuna</string>
    <string name="welcome_tagline">Fortuna tracks what you own and what you owe, and how it changes over time.</string>
    <string name="welcome_phone_title">Stays on this phone</string>
    <string name="welcome_phone_body">Your data is never sent anywhere.</string>
    <string name="welcome_account_title">No account</string>
    <string name="welcome_account_body">There is nothing to sign up for, and no network access.</string>
    <string name="welcome_keys_title">PIN and recovery phrase</string>
    <string name="welcome_keys_body">The PIN protects your data. The phrase gets you back in if you forget it.</string>
    <string name="welcome_warning">If you lose both your PIN and your recovery phrase, nobody can recover your data.</string>
    <string name="welcome_start">Get started</string>

    <!-- S-02 Create PIN -->
    <string name="pin_create_title">Choose a PIN</string>
    <string name="pin_create_body">Use six digits or more. You will enter it each time you open Fortuna.</string>
    <string name="pin_repeat_title">Enter your PIN again</string>
    <string name="pin_repeat_body">To make sure it is the one you meant.</string>
    <string name="pin_too_short">A PIN needs at least six digits.</string>
    <string name="pin_did_not_match">The two PINs were different. Choose your PIN again.</string>

    <!-- The number pad -->
    <string name="pin_delete">Delete</string>
    <string name="pin_ok">OK</string>
    <string name="pin_digits_entered">%1$d digits entered</string>

    <!-- S-03 Recovery phrase -->
    <string name="phrase_title">Your recovery phrase</string>
    <string name="phrase_body">Write these twelve words down on paper, in order, and keep them somewhere safe. They are the only way back in if you forget your PIN. This is the only time they are shown.</string>
    <string name="phrase_written_down">I have written them down</string>

    <!-- S-04 Confirm phrase -->
    <string name="confirm_title">Check your phrase</string>
    <string name="confirm_body">Enter these words from what you wrote down.</string>
    <string name="confirm_word_label">Word %1$d</string>
    <string name="confirm_wrong">Those words do not match. Look at the phrase again and check what you wrote.</string>
    <string name="confirm_button">Check</string>
    <string name="confirm_show_again">Show the phrase again</string>

    <!-- S-05 Base currency -->
    <string name="currency_title">Your main currency</string>
    <string name="currency_body">Totals and charts are shown in this currency. Accounts in other currencies are converted to it.</string>
    <string name="currency_search">Search by name or code</string>
    <string name="currency_suggested">Your region\'s currency</string>

    <!-- S-07 Lock -->
    <string name="lock_title">Fortuna is locked</string>
    <string name="lock_body">Enter your PIN.</string>
    <string name="lock_wrong_pin">That PIN is not right.</string>
    <string name="lock_not_this_device">This phone can no longer open your data with the PIN. Your recovery phrase will get you back in.</string>
    <string name="lock_wait">Try again in %1$s</string>

    <!-- S-09 Dashboard -->
    <string name="dashboard_lock">Lock</string>
    <string name="dashboard_net_worth">Net worth</string>
    <string name="dashboard_assets">Assets</string>
    <string name="dashboard_liabilities">Liabilities</string>
    <string name="dashboard_sources">Your accounts</string>
    <string name="dashboard_source_detail">%1$s · Updated %2$s</string>
    <string name="dashboard_owed">Owed</string>
    <string name="dashboard_add_source">Add</string>
    <string name="dashboard_empty_title">Add your first account</string>
    <string name="dashboard_empty_body">Add the accounts, investments, property and debts you want to track. Your net worth is worked out from them.</string>
    <string name="dashboard_add_first">Add an account</string>

    <!-- S-11 Add source -->
    <string name="add_source_title">Add an account</string>
    <string name="add_source_body">Anything that holds value or that you owe: a bank account, a pension, a property, a loan. Start with its value on a date; you update it from then on.</string>
    <string name="add_source_name">Name</string>
    <string name="add_source_category">Category</string>
    <string name="add_source_is_asset">This counts as something you own.</string>
    <string name="add_source_is_liability">This counts as something you owe. Enter what you owe as a positive amount.</string>
    <string name="add_source_amount">Value (%1$s)</string>
    <string name="add_source_date_today">Value as of today</string>
    <string name="add_source_date">Value as of %1$s</string>
    <string name="add_source_date_ok">OK</string>
    <string name="add_source_date_cancel">Cancel</string>
    <string name="add_source_note">Note (optional)</string>
    <string name="add_source_save">Add</string>
    <string name="add_source_problem_no_name">Give it a name.</string>
    <string name="add_source_problem_name_in_use">You already have one with that name.</string>
    <string name="add_source_problem_no_category">Choose a category.</string>
    <string name="add_source_problem_no_amount">Enter its value.</string>
    <string name="add_source_problem_not_an_amount">That is not an amount.</string>
    <string name="add_source_problem_decimal_places">That has more decimal places than the currency uses.</string>
    <string name="add_source_problem_too_large">That amount is too large.</string>
    <string name="add_source_problem_future">The date cannot be in the future.</string>
    <string name="add_source_problem_not_saved">That could not be saved. Nothing was changed.</string>
</resources>
