    <string name="source_delete_source_title">Delete %1$s?</string>
    <string name="source_delete_source_text">It has only its opening value, so nothing else is lost. This cannot be undone.</string>

    <!-- S-12 Value entry -->
    <string name="value_new_title">New value for %1$s</string>
    <string name="value_new_body">Enter what it is worth now, as on its latest statement.</string>
    <string name="value_edit_title">Correct %1$s</string>
    <string name="value_edit_body">Change the figures recorded for this date. The date itself stays.</string>
    <string name="value_value">Value (%1$s)</string>
    <string name="value_added">Amount added (optional)</string>
